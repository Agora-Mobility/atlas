# Copy to .env and adjust. Never commit .env.
# Values here target `make run` on the host; docker-compose overrides the
# connection URLs so the api container reaches the other containers by name.

# --- Application -------------------------------------------------------------
APP_NAME=atlas
# development | staging | production | test
APP_ENV=development
# debug | info | warn | error
LOG_LEVEL=debug
LOG_OUTPUT=stdout

# --- Docker (dev container) --------------------------------------------------
# Match `id -u` / `id -g` so the api container can write to the bind mount.
LOCAL_UID=1000
LOCAL_GID=1000

# --- HTTP --------------------------------------------------------------------
HTTP_PORT=8700
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=20s
# Comma-separated list. "*" is rejected in production.
CORS_ALLOWED_ORIGINS=*
# Comma-separated IPs/CIDRs of reverse proxies (Nginx, load balancer) whose
# X-Forwarded-For is trusted for the client IP. Empty trusts none.
TRUSTED_PROXIES=
# Requests allowed per client IP in each window (Redis-backed).
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
# Stricter limit for login, sign-up, OTP and password reset.
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW=1m

# --- PostgreSQL / PostGIS ----------------------------------------------------
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
POSTGRES_DB=atlas
POSTGRES_PORT=5432
DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=15m
DB_MIGRATE_ON_START=true

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=atlas
REDIS_PORT=6379
REDIS_ADDR=localhost:6379
REDIS_DB=0

# --- RabbitMQ ----------------------------------------------------------------
RABBITMQ_USER=atlas
RABBITMQ_PASSWORD=atlas
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://atlas:atlas@localhost:5672/
RABBITMQ_EXCHANGE=agora.events
# Unacknowledged messages per consumer.
RABBITMQ_PREFETCH=10
# Attempts before a message goes to the DLQ.
RABBITMQ_MAX_RETRIES=5
# Time a failed message waits in the retry queue.
RABBITMQ_RETRY_DELAY=10s
# How long processed event ids are remembered for idempotency.
EVENT_DEDUP_TTL=24h

# --- Outbox relay ------------------------------------------------------------
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=100

# --- JWT ---------------------------------------------------------------------
# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-of-32-chars-min
JWT_ISSUER=atlas
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# --- OTP (SMS codes for phone verification and password reset) ---------------
OTP_TTL=5m
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60s

# --- Monitoring --------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- SMS (CastBrick) ---------------------------------------------------------
# Required in production. Left empty elsewhere, SMS are written to the log.
CASTBRICK_API_KEY=
CASTBRICK_BASE_URL=https://api.castbrick.co/v1
CASTBRICK_SENDER_ID=
CASTBRICK_TIMEOUT=10s

# --- E-mail (Resend) ---------------------------------------------------------
# Required in production. Left empty elsewhere, e-mails are written to the log.
# EMAIL_FROM must use a domain verified in Resend, e.g. "Agora <no-reply@agora.ao>".
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
RESEND_TIMEOUT=10s
EMAIL_FROM=
EMAIL_REPLY_TO=

# --- First admin (cmd/bootstrap-admin) ---------------------------------------
# Used once per environment to create the first admin when none exists.
# In production run `/bootstrap-admin` from the api image with these set, then

# --- Access (RBAC, invitations) ------------------------------------------
PERMISSION_CACHE_TTL=5m
INVITATION_URL_BACKOFFICE=http://localhost:3001/convite
INVITATION_URL_PARTNER_PANEL=http://localhost:3002/convite

# remove the password from the environment.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Dispatch --------------------------------------------------------------
DISPATCH_WATCHER_INTERVAL=1s
DISPATCH_WATCHER_BATCH=200
DISPATCH_CHANNEL_TIMEOUT=5s
FARE_ESTIMATE_TTL=5m
NEARBY_MIN_CELL_COUNT=3
LOCATION_MAX_ACCURACY_M=100
LOCATION_MAX_SPEED_KMH=200
LOCATION_HISTORY_RETENTION=720h
OFFER_DEEP_LINK_BASE=agoraprovider://app
OPERATOR_ALERT_PHONE=
IDEMPOTENCY_TTL=24h
NOTIFICATION_WORKERS=8
REALTIME_PROJECTOR_WORKERS=16

# --- Real time (SSE) -------------------------------------------------------
SSE_HEARTBEAT_INTERVAL=15s
SSE_POLL_INTERVAL=30s
SSE_DEAD_AFTER=38s
SSE_MAILBOX_MAX_ENTRIES=200
SSE_MAILBOX_TTL=24h
SSE_RECONNECT_SPREAD=30s

# --- Google Maps (server key only; the apps use their own restricted keys) ---
# Left empty, routes use distance x road factor and quotes are marked "fallback".
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BASE_URL=https://routes.googleapis.com
GOOGLE_MAPS_TIMEOUT=2s
GOOGLE_MAPS_BREAKER_FAILURES=5
GOOGLE_MAPS_BREAKER_COOLDOWN=30s
ROUTING_ROAD_FACTOR=1.4
ROUTING_FALLBACK_SPEED_KMH=25

# --- Firebase Cloud Messaging ------------------------------------------------
# FCM_CREDENTIALS_JSON is the service account JSON on one line. Left empty,
# pushes are written to the log.
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=
FCM_BASE_URL=https://fcm.googleapis.com
FCM_TIMEOUT=5s

# --- Provider documents (Cloudflare R2, private bucket) ----------------------
# Required in production. Without them the document endpoints answer 503.
# R2_ENDPOINT may stay empty: it comes from R2_ACCOUNT_ID.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PRESIGN_TTL=15m

# --- Provider verification (AGORA Pro) ---------------------------------------
# Quality, OCR and liveness adapters: fake (dev, passes and fails on demand) or
# manual (the team reviews everything). Production refuses fake.
VERIFICATION_QUALITY_PROVIDER=fake
VERIFICATION_OCR_PROVIDER=fake
VERIFICATION_LIVENESS_PROVIDER=fake
# Force fake failures: quality reasons (BLURRY,GLARE,...), OCR and liveness.
# A file containing FAKE:<REASON>, FAKE:OCR_FAIL or FAKE:LIVENESS_FAIL fails too.
VERIFICATION_FAKE_QUALITY_REASONS=
VERIFICATION_FAKE_OCR_FAIL=false
VERIFICATION_FAKE_LIVENESS_FAIL=false
VERIFICATION_MAX_FILE_BYTES=10485760
VERIFICATION_READ_URL_TTL=5m
VERIFICATION_MIN_PROVIDER_AGE=18
VERIFICATION_MAX_ATTEMPTS=3
VERIFICATION_CRIMINAL_RECORD_MAX_DAYS=90
VERIFICATION_CERTIFICATE_MAX_MONTHS=6
VERIFICATION_EXPIRY_NOTICE_DAYS=30
VERIFICATION_PENDING_UPLOAD_TTL=24h
VERIFICATION_REMINDER_DELAY=24h
VERIFICATION_HOUSEKEEPING_INTERVAL=1h
VERIFICATION_UPLOAD_RATE_LIMIT=60
VERIFICATION_CHECK_RATE_LIMIT=15
VERIFICATION_RATE_WINDOW=1m
VERIFICATION_WORKERS=4

# AppyPay payment gateway
APPYPAY_CLIENT_ID=
APPYPAY_CLIENT_SECRET=
APPYPAY_BASE_URL=https://gwy-api-tst.appypay.co.ao/v2.0
APPYPAY_TOKEN_URL=https://login.microsoftonline.com/appypaydev.onmicrosoft.com/oauth2/token
APPYPAY_RESOURCE=2aed7612-de64-46b5-9e59-1f48f8902d14
APPYPAY_GPO_METHOD=
APPYPAY_REF_METHOD=
APPYPAY_TIMEOUT=30s
PAYMENT_GPO_WINDOW=5m
PAYMENT_REFERENCE_TTL=72h
PAYMENT_RECONCILE_INTERVAL=5s
PAYMENT_RECONCILE_BATCH=50
PAYMENT_GPO_CHECK_INTERVAL=5s
PAYMENT_REFERENCE_CHECK_INTERVAL=10m
LEDGER_CURRENCY=AOA

# Masked calls. Without a provider the API answers 503 CALLS_UNAVAILABLE
CALLS_BASE_URL=
CALLS_API_KEY=
CALLS_TIMEOUT=5s

# Base of the public link that shares a trip
SHARE_BASE_URL=https://agora.ao/v
