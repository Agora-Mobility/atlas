FROM golang:1.27.3-alpine

ARG UID=1000
ARG GID=1000

# hadolint ignore=DL3018
RUN apk add --no-cache ca-certificates git make curl bash postgresql-client gcc musl-dev \
    && addgroup -g "${GID}" atlas \
    && adduser -D -u "${UID}" -G atlas atlas \
    && mkdir -p /app /go/pkg/mod /home/atlas/.cache/go-build \
    && chown -R atlas:atlas /app /go /home/atlas/.cache

ENV GOPROXY=https://proxy.golang.org,direct \
    GOSUMDB=sum.golang.org \
    GOTOOLCHAIN=local \
    GOCACHE=/home/atlas/.cache/go-build \
    CGO_ENABLED=1

COPY --chmod=755 entrypoint.sh /usr/local/bin/entrypoint.sh

USER ${UID}:${GID}

RUN go install github.com/air-verse/air@v1.67.4

WORKDIR /app

COPY --chown=atlas:atlas go.mod go.sum ./
RUN go mod download

COPY --chown=atlas:atlas . .

EXPOSE 8700

ENTRYPOINT ["entrypoint.sh"]
CMD ["air", "-c", ".air.toml"]
