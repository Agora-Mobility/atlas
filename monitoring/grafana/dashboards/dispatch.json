      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, source) (rate(atlas_business_candidate_search_seconds_bucket[5m])))",
          "legendFormat": "__auto",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Cells per search (p95)",
