        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, source) (rate(atlas_business_candidate_search_cells_bucket[5m])))",
          "legendFormat": "__auto",
          "refId": "A"
        }
      ]
    },
    {
